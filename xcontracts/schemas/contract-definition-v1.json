{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xork:contracts:contract-definition:1",
  "title": "Contract definition v1",
  "description": "A versioned agreement between two independently implemented roles. Structural validity is not behavioral conformance.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "roles"],
  "properties": {
    "schema_version": {"type": "string", "const": "1"},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "artifacts": {
      "type": "object",
      "propertyNames": {"type": "string", "minLength": 1},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["format", "purpose", "content"],
        "properties": {
          "format": {"type": "string", "minLength": 1},
          "purpose": {"enum": ["definition", "derived", "example"]},
          "content": {"type": "string", "minLength": 1},
          "selector": {"type": "string", "minLength": 1}
        }
      }
    },
    "roles": {
      "type": "object",
      "minProperties": 2,
      "maxProperties": 2,
      "propertyNames": {"type": "string", "minLength": 1},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["obligations"],
        "properties": {
          "obligations": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
